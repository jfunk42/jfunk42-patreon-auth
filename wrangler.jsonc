{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "jfunk42-patreon-auth",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-17",
	"observability": {
		"enabled": true
	},
	"vars": {
		"PUBLIC_SITE_ORIGIN": "https://jfunk42.com"
	},
	"routes": [
		{
			"pattern": "api.jfunk42.com",
			"custom_domain": true
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "jfunk42-patreon-auth",
			"database_id": "b2565b99-cb10-49cf-b7b4-a6f45acac5cc",
			"migrations_dir": "migrations"
		}
	]
}
